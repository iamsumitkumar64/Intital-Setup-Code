ARG NODE_IMAGE=node:24.15.0-alpine
ARG PORT=8080






# Stage 1: Base runtime
FROM ${NODE_IMAGE} AS base

WORKDIR /app

# Environment variables
ENV HOSTNAME="0.0.0.0"

# default node user owns /app
RUN chown -R node:node /app

# Copy dependency files
COPY --chown=node:node package.json package-lock.json ./

# Switch to default non-root user
USER node

# Install locked dependencies for the build
RUN npm ci

# Copy source code and configuration
COPY --chown=node:node tsconfig.json tsconfig.build.json nest-cli.json ./
COPY --chown=node:node src/ ./src/

# Expose the application port
EXPOSE ${PORT}








# Stage 2: dev runtime
FROM base AS dev

# Start the application
CMD ["npm", "run", "start:dev"]








# Stage 3: Build
FROM base AS builder

# Build the NestJS application
RUN npm run build








# Stage 4: Production runtime
FROM ${NODE_IMAGE} AS production

WORKDIR /app

# Install dumb-init for proper signal forwarding
RUN apk add --no-cache dumb-init

# Ensure default node user owns /app
RUN chown -R node:node /app

# Environment variables
ENV NODE_ENV=production
ENV HOSTNAME="0.0.0.0"

# Copy package files with --chown
COPY --chown=node:node package.json package-lock.json ./

# Switch to default non-root user
USER node

# Clean install production dependencies
RUN npm ci --omit=dev

# Copy compiled build output from builder
COPY --from=builder --chown=node:node /app/dist ./dist

# Expose the application port
EXPOSE ${PORT}

# Start the application
CMD ["dumb-init", "node", "dist/main.js"]