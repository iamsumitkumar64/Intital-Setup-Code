ARG NODE_IMAGE=node:24.15.0-alpine







# Stage 1: Base runtime
FROM ${NODE_IMAGE} AS base

WORKDIR /app

# Build arguments for Next.js NEXT_PUBLIC_* variables
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_FRONTEND_URL
ARG NEXT_PUBLIC_DEFAULT_PAGE
ARG NEXT_PUBLIC_DEFAULT_LIMIT

# Environment variables
ENV NEXT_PUBLIC_BACKEND_URL=${NEXT_PUBLIC_BACKEND_URL}
ENV NEXT_PUBLIC_FRONTEND_URL=${NEXT_PUBLIC_FRONTEND_URL}
ENV NEXT_PUBLIC_DEFAULT_PAGE=${NEXT_PUBLIC_DEFAULT_PAGE}
ENV NEXT_PUBLIC_DEFAULT_LIMIT=${NEXT_PUBLIC_DEFAULT_LIMIT}
ENV HOSTNAME="0.0.0.0"

# Copy dependency files
COPY --chown=node:node package.json package-lock.json ./
COPY --chown=node:node next.config.ts /app/next.config.ts

# Switch to default non-root user
USER node

# Install locked dependencies for the build
RUN npm ci

# Copy source files
COPY --chown=node:node . .

# Expose the application port
EXPOSE 3000






# Stage 2: dev runtime
FROM base AS dev

# Start the application in dev mode
CMD ["npm", "run", "dev"]







# Stage 3: Build
FROM base AS builder

# Build the NextJS application
RUN npm run build







# Stage 4: Production runtime
FROM ${NODE_IMAGE} AS production

WORKDIR /app

# Install dumb-init for proper signal forwarding
RUN apk add --no-cache dumb-init

# Environment variables
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Copy built application output from builder
COPY --from=builder --chown=node:node /app/public ./public
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

# Switch to default non-root user
USER node

# Expose the application port
EXPOSE 3000

# Start the application
CMD ["dumb-init", "node", "server.js"]